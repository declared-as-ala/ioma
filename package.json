{
  "name": "ioma-paris-dubai",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.31.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "turbo run build --filter=\"./packages/*\" && turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "check-i18n": "npx tsx packages/infra-scripts/src/check-i18n.ts",
    "clean": "turbo run clean",
    "seed": "pnpm --filter @ioma/api seed",
    "seed:official": "pnpm --filter @ioma/api seed:official",
    "import:catalog": "pnpm --filter @ioma/api import:catalog",
    "format": "prettier --write \"**/*.{ts,tsx,md,json}\" --ignore-path .gitignore",
    "prepare": "husky"
  },
  "devDependencies": {
    "@ioma/eslint-config": "workspace:*",
    "eslint": "^9.17.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.5.1",
    "prettier": "^3.4.2",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix"
    ],
    "*.{ts,tsx,md,json}": [
      "prettier --write"
    ]
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "argon2",
      "sharp",
      "esbuild",
      "msgpackr-extract",
      "@scarf/scarf"
    ]
  }
}
