# See ENVIRONMENT.md for full documentation of every variable.

NODE_ENV=development
PORT=4000
WEB_PORT=3000
APP_URL=http://localhost:3000
API_URL=http://localhost:4000
# Browser-exposed API base URL (Next.js only ships NEXT_PUBLIC_* vars to the
# client bundle). Dev: points directly at the API's own port. Production:
# leave empty — the reverse proxy serves web and api same-origin under /api,
# so the browser can call relative paths with no CORS/env coupling at all.
NEXT_PUBLIC_API_URL=http://localhost:4000

# Defaults below target the documented default dev workflow (DEPLOYMENT.md):
# infra containerized via `docker compose up -d mongo redis minio`, apps run
# locally via `pnpm dev` — so these must resolve from the host, not from
# inside the Docker network. `docker-compose.yml`'s `api`/`web` services
# override all three to the internal Docker hostnames (mongo/redis/minio)
# in their own `environment:` block when the whole stack runs containerized.
MONGO_URI=mongodb://localhost:27017/ioma
REDIS_URL=redis://localhost:6379

MINIO_ENDPOINT=localhost
MINIO_PORT=9010
MINIO_ACCESS_KEY=ioma_dev_access
MINIO_SECRET_KEY=ioma_dev_secret_change_me
MINIO_USE_SSL=false
MINIO_BUCKET_PUBLIC=ioma-public
MINIO_BUCKET_PRIVATE=ioma-private
MINIO_SIGNED_URL_TTL_SECONDS=300

JWT_ACCESS_SECRET=dev_access_secret_change_me_min_32_chars
JWT_REFRESH_SECRET=dev_refresh_secret_change_me_min_32_chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

PAYMENT_PROVIDER=mock
PAYMENT_API_KEY=
PAYMENT_WEBHOOK_SECRET=

AI_PROVIDER=mock
AI_PROVIDER_API_KEY=
GEMINI_API_KEY=
AI_ANALYSIS_RETENTION_DAYS=90

# ElevenLabs Premium Female Voice (Optional)
ELEVENLABS_API_KEY=
AI_VOICE_EN_ID=EXAVITQu4vr4xnSDxMaL
AI_VOICE_AR_ID=21m00Tcm4TlvDq8ikWAM

# Live Avatar Provider (Optional: HeyGen, D-ID, Tavus)
HEYGEN_API_KEY=
HEYGEN_AVATAR_ID=Eleonore_French_Skincare_Consultant_v2
DID_API_KEY=
TAVUS_API_KEY=

MAP_PROVIDER=osm
MAPS_API_KEY=

EMAIL_PROVIDER=smtp-dev
SMTP_HOST=mailhog
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=no-reply@ioma-dev.local

SENTRY_DSN=
LOG_LEVEL=debug

SEARCH_PROVIDER=mongo
MEILISEARCH_HOST=
MEILISEARCH_API_KEY=

SMS_PROVIDER=noop

DEFAULT_LOCALE=en
SUPPORTED_LOCALES=en,fr,ar
